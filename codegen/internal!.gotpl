
{{ range $directive := .BuiltInDirectives }}
	var (
		{{- $directive.FunctionImpl }}
	)
{{ end }}

type executableSchema graphql.ExecutableSchemaState[ResolverRoot, DirectiveRoot, ComplexityRoot]

func (e *executableSchema) Schema() *ast.Schema {
	if e.SchemaData != nil {
			return e.SchemaData
	}
	return parsedSchema
}

func (e *executableSchema) Complexity(ctx context.Context, typeName, field string, childComplexity int, rawArgs map[string]any) (int, bool) {
	ec := newExecutionContext(nil, e, nil)
	_ = ec
	{{- if not .Config.OmitComplexity }}
	switch typeName + "." + field {
	{{ range $object := .Objects }}
		{{ if not $object.IsReserved }}
			{{ range $_, $fields := $object.UniqueFields }}
				{{- $len := len $fields }}
				{{- range $i, $field := $fields }}
					{{- $last := eq (add $i 1) $len }}
					{{- if not $field.IsReserved }}
						{{- if eq $i 0 }}case {{ end }}"{{$object.Name}}.{{$field.Name}}"{{ if not $last }},{{ else }}:
						if e.ComplexityRoot.{{ucFirst $object.Name }}.{{$field.GoFieldName}} == nil {
						break
						}
						{{ if $field.Args }}
							args, err := {{$.ECDot}}{{ $field.ArgsFunc }}(ctx, {{$.ECArg}}rawArgs)
							if err != nil {
							return 0, false
							}
						{{ end }}
						return e.ComplexityRoot.{{ucFirst $object.Name}}.{{$field.GoFieldName}}(childComplexity{{if $field.Args}}, {{$field.ComplexityArgs}} {{ end }}), true
						{{- end }}
					{{- end }}
				{{- end }}
			{{ end }}
		{{ end }}
	{{ end }}
	}
	{{- end }}
	return 0, false
}

func (e *executableSchema) Exec(ctx context.Context) graphql.ResponseHandler {
	opCtx := graphql.GetOperationContext(ctx)
	ec := newExecutionContext(opCtx, e, make(chan graphql.DeferredResult))
	inputUnmarshalers := func() *graphql.InputUnmarshalerIndex {
		return graphql.NewInputUnmarshalerIndex(
		{{- range $input := .Inputs -}}
			{{ if not $input.HasUnmarshal }}
				{{- if $.Config.UseFunctionSyntaxForExecutionContext }}
				graphql.NewInputUnmarshaler({{ $input.Name | quote }}, graphql.BindUnmarshaler(ec, unmarshalInput{{ $input.Name }})),
				{{- else }}
				graphql.NewInputUnmarshaler({{ $input.Name | quote }}, ec.unmarshalInput{{ $input.Name }}),
				{{- end }}
			{{- end }}
		{{- end }}
		)
	}
	first := true

	switch opCtx.Operation.Operation {
	{{- if .QueryRoot }} case ast.Query:
		return func(ctx context.Context) *graphql.Response {
			var response graphql.Response
			var data graphql.Marshaler
			if first {
				first = false
				ctx = graphql.WithLazyInputUnmarshalerIndex(ctx, inputUnmarshalers)
				{{ if .AllDirectives.LocationDirectives "QUERY" -}}
					data = {{$.ECDot}}_queryMiddleware(ctx, {{$.ECArg}}opCtx.Operation, func(ctx context.Context) (any, error){
						return {{$.ECDot}}_{{.QueryRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet), nil
					})
				{{- else -}}
					data = {{$.ECDot}}_{{.QueryRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet)
				{{- end }}
			} else {
				if atomic.LoadInt32(&ec.PendingDeferred) > 0 {
					result := <-ec.DeferredResults
					atomic.AddInt32(&ec.PendingDeferred, -1)
					data = result.Result
					response.Path = result.Path
					response.Label = result.Label
					response.Errors = result.Errors
				} else {
					return nil
				}
			}
			var buf bytes.Buffer
			data.MarshalGQL(&buf)
			response.Data = buf.Bytes()
			if atomic.LoadInt32(&ec.Deferred) > 0 {
				hasNext := atomic.LoadInt32(&ec.PendingDeferred) > 0
				response.HasNext = &hasNext
			}

			return &response
		}
	{{ end }}

	{{- if .MutationRoot }} case ast.Mutation:
		return func(ctx context.Context) *graphql.Response {
			if !first { return nil }
			first = false
			ctx = graphql.WithLazyInputUnmarshalerIndex(ctx, inputUnmarshalers)
			{{ if .AllDirectives.LocationDirectives "MUTATION" -}}
				data := {{$.ECDot}}_mutationMiddleware(ctx, {{$.ECArg}}opCtx.Operation, func(ctx context.Context) (any, error){
					return {{$.ECDot}}_{{.MutationRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet), nil
				})
			{{- else -}}
				data := {{$.ECDot}}_{{.MutationRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet)
			{{- end }}
			var buf bytes.Buffer
			data.MarshalGQL(&buf)

			return &graphql.Response{
				Data:       buf.Bytes(),
			}
		}
	{{ end }}

	{{- if .SubscriptionRoot }} case ast.Subscription:
		{{- if .SubscriptionRoot.HasSubscriptionContextField }}
		// Exec discards the per-event context; the event-aware path is exposed
		// via ExecWithEventContext and used by the executor when it detects
		// ExecutableSchemaWithEventContext.
		return graphql.SubscriptionResponseHandler({{$.ECDot}}_{{.SubscriptionRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet))
		{{- else }}
		{{ if .AllDirectives.LocationDirectives "SUBSCRIPTION" -}}
			next := {{$.ECDot}}_subscriptionMiddleware(ctx, {{$.ECArg}}opCtx.Operation, func(ctx context.Context) (any, error){
				return {{$.ECDot}}_{{.SubscriptionRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet),nil
			})
		{{- else -}}
			next := {{$.ECDot}}_{{.SubscriptionRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet)
		{{- end }}

		var buf bytes.Buffer
		return func(ctx context.Context) *graphql.Response {
			buf.Reset()
			data := next(ctx)

			if data == nil {
				return nil
			}
			data.MarshalGQL(&buf)

			return &graphql.Response{
				Data:       buf.Bytes(),
			}
		}
		{{- end }}
	{{ end }}
	default:
		return graphql.OneShot(graphql.ErrorResponse(ctx, "unsupported GraphQL operation"))
	}
}

{{- if and .SubscriptionRoot (.SubscriptionRoot.HasSubscriptionContextField) }}

// ExecWithEventContext is the per-event-context-aware response handler. The
// graphql executor type-asserts the executable schema for this method when
// at least one subscription field is annotated @subscriptionContext; absence
// falls back to Exec.
func (e *executableSchema) ExecWithEventContext(ctx context.Context) graphql.ResponseHandlerWithContext {
	opCtx := graphql.GetOperationContext(ctx)
	ec := newExecutionContext(opCtx, e, make(chan graphql.DeferredResult))

	switch opCtx.Operation.Operation {
	case ast.Subscription:
		return graphql.SubscriptionEventResponseHandler({{$.ECDot}}_{{.SubscriptionRoot.Name}}(ctx, {{$.ECArg}}opCtx.Operation.SelectionSet))
	default:
		// Non-subscription operations fall through to Exec via the executor's
		// default path; this method only handles ast.Subscription.
		return func(ctx context.Context) (context.Context, *graphql.Response) {
			return ctx, graphql.ErrorResponse(ctx, "ExecWithEventContext only handles subscriptions")
		}
	}
}
{{- end }}

type executionContext struct {
	*graphql.ExecutionContextState[ResolverRoot, DirectiveRoot, ComplexityRoot]
}

func newExecutionContext(
	opCtx *graphql.OperationContext,
	execSchema *executableSchema,
	deferredResults chan graphql.DeferredResult,
) *executionContext {
	return &executionContext{
		ExecutionContextState: graphql.NewExecutionContextState[ResolverRoot, DirectiveRoot, ComplexityRoot](
			opCtx,
			(*graphql.ExecutableSchemaState[ResolverRoot, DirectiveRoot, ComplexityRoot])(execSchema),
			parsedSchema,
			deferredResults,
		),
	}
}


{{if .HasEmbeddableSources }}
//go:embed{{- range $source := .AugmentedSources }}{{if $source.Embeddable}} {{$source.RelativePath|quote}}{{end}}{{- end }}
var sourcesFS embed.FS

func sourceData(filename string) string {
	data, err := sourcesFS.ReadFile(filename)
	if err != nil {
		panic(fmt.Sprintf("codegen problem: %s not available", filename))
	}
	return string(data)
}
{{- end}}

var sources = []*ast.Source{
{{- range $source := .AugmentedSources }}
	{Name: {{$source.RelativePath|quote}}, Input: {{if (not $source.Embeddable)}}{{$source.Source|rawQuote}}{{else}}sourceData({{$source.RelativePath|quote}}){{end}}, BuiltIn: {{$source.BuiltIn}}},
{{- end }}
}
var parsedSchema = gqlparser.MustLoadSchema(sources...)

// fieldContextID identifies a schema field's row in fieldContextDescs.
type fieldContextID int

// The constants and the fieldContextDescs rows are grouped by object, so gofmt aligns each
// group on its own and a long field name does not realign the whole table.
const (
{{- $first := true }}
{{- range $object := .Objects }}{{- if $object.Fields }}
{{- if not $first }}
{{ end }}
	// {{ $object.Name }}
{{- range $field := $object.Fields }}
	{{ $field.FieldContextID }}{{ if $first }} fieldContextID = iota{{ $first = false }}{{ end }}
{{- end }}
{{- end }}{{- end }}
)

// fieldContextDesc is the request-independent part of a field's graphql.FieldContext.
// fieldContextDescs holds one per schema field, so a single fieldContextByID replaces a
// constructor per field.
type fieldContextDesc struct {
	object     string
	child      func({{$.ECFuncValueParams}}field graphql.CollectedField) (*graphql.FieldContext, error)
	args       func({{$.ECFuncValueParams}}rawArgs map[string]any) (map[string]any, error)
	isMethod   bool
	isResolver bool
}

// fieldContextDescs is filled in init rather than by its initializer because it refers to
// the childFields_* functions, which read it back through fieldContextByID; the compiler
// rejects that as an initialization cycle.
var fieldContextDescs []fieldContextDesc

func init() {
	fieldContextDescs = []fieldContextDesc{
	{{- $firstRow := true }}
	{{- range $object := .Objects }}{{- if $object.Fields }}
	{{- if not $firstRow }}
{{ end }}{{ $firstRow = false }}
	{{- range $field := $object.Fields }}
		{{ $field.FieldContextID }}: {object: {{ quote $object.Name }}, child: {{$.ECFuncValue}}childFields_{{ $field.ChildFieldContextTypeName }}
			{{- if $field.Args }}, args: {{$.ECFuncValue}}{{ $field.ArgsFunc }}{{ end }}
			{{- if or $field.IsMethod $field.IsResolver }}, isMethod: true{{ end }}
			{{- if $field.IsResolver }}, isResolver: true{{ end }}},
	{{- end }}
	{{- end }}{{- end }}
	}
}

func {{$.FuncReceiver}}fieldContextByID(ctx context.Context, {{$.ECFuncParam}}field graphql.CollectedField, id fieldContextID) (fc *graphql.FieldContext, err error) {
	d := &fieldContextDescs[id]
	fc = &graphql.FieldContext{
		Object:     d.object,
		Field:      field,
		IsMethod:   d.isMethod,
		IsResolver: d.isResolver,
		Child: func(ctx context.Context, field graphql.CollectedField) (*graphql.FieldContext, error) {
			return d.child({{$.ECFuncValueArgs}}field)
		},
	}
	if d.args == nil {
		return fc, nil
	}
	{{- if not $.Config.OmitPanicHandler }}
	defer func() {
		if r := recover(); r != nil {
			err = ec.Recover(ctx, r)
			ec.Error(ctx, err)
		}
	}()
	{{- end }}
	ctx = graphql.WithFieldContext(ctx, fc)
	if fc.Args, err = d.args({{$.ECFuncValueArgs}}field.ArgumentMap(ec.Variables)); err != nil {
		ec.Error(ctx, err)
		return fc, err
	}
	return fc, nil
}

// childFields_* functions are the FieldContext.Child dispatchers, generated once per type
// that fields return rather than once per field.
{{- range $ct := .ChildFieldTypes }}

func {{$.FuncReceiver}}childFields_{{ $ct.TypeName }}(ctx context.Context, {{$.ECFuncParam}}field graphql.CollectedField) (*graphql.FieldContext, error) {
	{{- if not $ct.Definition.Fields }}
	return nil, errors.New("field of type {{ $ct.TypeName }} does not have child fields")
	{{- else if ne $ct.Definition.Kind "OBJECT" }}
	return nil, errors.New("FieldContext.Child cannot be called on type {{ $ct.Definition.Kind }}")
	{{- else }}
	switch field.Name {
	{{- range $f := $ct.Definition.Fields }}
	case "{{ $f.Name }}":
		return {{$.ECDot}}fieldContextByID(ctx, {{$.ECArg}}field, {{ $ct.FieldContextID $f.Name }})
	{{- end }}
	}
	return nil, fmt.Errorf("no field named %q was found under type {{ $ct.TypeName }}", field.Name)
	{{- end }}
}
{{- end }}

{{ template "globalMiddleware" . }}
